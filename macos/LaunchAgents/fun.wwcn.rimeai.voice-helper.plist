<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fun.wwcn.rimeai.voice-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HELPER_APP__/Contents/MacOS/rimeai-voice-helper</string>
    <string>__TRANSPORT_FLAG__</string>
    <string>__TRANSPORT_ENDPOINT__</string>
    <string>__ENGINE_FLAG__</string>
    <string>__ENGINE_NAME__</string>
  </array>
  <key>MachServices</key>
  <dict>
    <key>fun.wwcn.rimeai.voice-helper</key>
    <true/>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RIMEAI_PAIRED_BUILD</key>
    <string>__HOST_BUILD__</string>
    <key>RIMEAI_VOICE_POLICY_SHA256</key>
    <string>__VOICE_POLICY_SHA256__</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__ENABLED_MARKER__</key>
      <true/>
    </dict>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__</string>
</dict>
</plist>
