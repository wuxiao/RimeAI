<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fun.wwcn.rimeai.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DAEMON_EXECUTABLE__</string>
    <string>--socket</string>
    <string>__SOCKET__</string>
    <string>--language-model</string>
    <string>__LANGUAGE_MODEL__</string>
    <string>--beam-config</string>
    <string>__BEAM_CONFIG__</string>
    <string>--rime-dictionary</string>
    <string>__RIME_DICTIONARY__</string>
    <string>--neural-model</string>
    <string>__NEURAL_MODEL__</string>
    <string>--fusion-config</string>
    <string>__FUSION_CONFIG__</string>
    <string>--neural-device</string>
    <string>cpu</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RELEASE_ROOT__</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__ENABLED_MARKER__</key>
      <true/>
    </dict>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>COPYFILE_DISABLE</key>
    <string>1</string>
  </dict>
</dict>
</plist>
